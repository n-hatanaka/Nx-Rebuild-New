@using static __Main

<style>
    .grid-table {
        width: max-content;
    }

    .grid-row {
        display: flex;
        flex-wrap: nowrap;
        width: max-content;
        align-items: center;
        border-bottom: 1px solid #eee;
        cursor: grab;
        touch-action: manipulation;
    }

    .grid-row.selected {
        background-color: #e3f2fd;
    }

    .grid-row.editing {
        cursor: default;
    }

    /* ドラッグハンドルの操作性を維持 */
    .drag-handle {
        pointer-events: auto !important;
        width: 30px;
        text-align: center;
        color: #ccc;
    }

    /* セル（右寄せ・左寄せ） */
    .grid-cell {
        padding: 8px;
        flex-shrink: 0;
        box-sizing: border-box;
    }

    .grid-cell-left {
        text-align: left;
    }

    .grid-cell-right {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    /* ヘッダー固有：ソートのために子要素のクリックを許可 */
    .grid-header {
        font-weight: bold;
        background-color: #eee;
        border-bottom: 2px solid #ccc;
    }
    
    .grid-header * {
        pointer-events: auto !important;
    }

    /* セル内のテキストなどのクリック透過 */
    .grid-row:not(.editing) > *:not(.drag-handle) {
        pointer-events: none;
    }

    /* 編集用インプット */
    .grid-edit-input {
        width: 100%;
        border: 1px solid #594ae2;
        background: white;
        color: black;
        outline: none;
        padding: 2px 4px;
        font-size: 0.9rem;
    }
</style>

<div class="scroll-pane grid-pane">
    <MudText Typo="Typo.subtitle2">データ一覧</MudText>
    <div class="grid-table" style="margin-top: 8px;">
        @* --- ヘッダー部分 --- *@
        <div class="grid-row grid-header">
            <div style="width: 30px; flex-shrink: 0;"></div>
            
            @* --- 項目名ヘッダー (クラスを動的に判定) --- *@
            <div class="grid-cell @GetNameAlignClass()" 
                 style="width: 200px; min-width: 200px; flex-shrink: 0; user-select: none; @(AllowSorting ? "cursor: pointer;" : "cursor: default;")"
                 @onclick='() => Sort("Name")'>
                項目名 @(AllowSorting ? GetSortIcon("Name") : "")
            </div>

            @* 動的カラムヘッダー *@
            @foreach (var col in Columns.Where(c => c.DataKey != "Name")) {
                <div class="grid-cell @col.AlignClass" 
                     style="width: @(col.Width)px; min-width: @(col.Width)px; flex-shrink: 0; user-select: none; @(AllowSorting ? "cursor: pointer;" : "cursor: default;")"
                     @onclick='() => Sort(col.DataKey)'>
                    @col.Caption @(AllowSorting ? GetSortIcon(col.DataKey) : "")
                </div>
            }
        </div>

        @* --- 明細部分 --- *@
        @foreach (var (item, index) in GridDataItems.Select((v, i) => (v, i))) {
            @if (item.IsEditing) {
                <div class="grid-row editing" draggable="false"
                     @onclick:stopPropagation="true" @onmousedown:stopPropagation="true" @ondblclick:stopPropagation="true">
                    
                    <div class="drag-handle" style="opacity: 0.3; cursor: default; width: 30px; flex-shrink: 0;">
                        <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small"/>
                    </div>

                    @* 項目名編集セル (配置を動的に解決) *@
                    <div class="grid-cell @GetNameAlignClass()" style="width: 200px; min-width: 200px; flex-shrink: 0;">
                        <input @ref="_gridInputRef" @key="@($"gridedit-{item.GetHashCode()}")"
                               @bind="item.Name" @bind:event="oninput" class="grid-edit-input" autofocus
                               @onfocusout="() => { item.IsEditing = false; StateHasChanged(); }"
                               @onkeyup='(e) => { if(e.Key == "Enter" || e.Key == "Escape") { item.IsEditing = false; StateHasChanged(); } }' />
                    </div>

                    @foreach (var col in Columns.Where(c => c.DataKey != "Name")) {
                        <div class="grid-cell @col.AlignClass" style="width: @(col.Width)px; min-width: @(col.Width)px; flex-shrink: 0; color: #999;">
                            @(item.ExtraData.ContainsKey(col.DataKey) ? item.ExtraData[col.DataKey] : "-")
                        </div>
                    }
                </div>
            } else {
                <div class="grid-row @(item.IsSelected ? "selected" : "")" draggable="true"
                     @ondragstart="() => DraggingState.DraggingGridItem = item"
                     @ondrop="() => DropRow(index)"
                     @ondragover:preventDefault="true"
                     @onclick="(e) => HandleClick(item, e)"
                     @ondblclick="() => HandleDoubleClick(item)"
                     @ondblclick:stopPropagation="true">
                    
                    <div class="drag-handle" style="width: 30px; flex-shrink: 0;">
                        <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small"/>
                    </div>

                    @* 項目名表示セル (配置を動的に解決) *@
                    <div class="grid-cell @GetNameAlignClass()" style="width: 200px; min-width: 200px; flex-shrink: 0;">
                        <span>@item.Name</span>
                    </div>

                    @foreach (var col in Columns.Where(c => c.DataKey != "Name")) {
                        <div class="grid-cell @col.AlignClass" style="width: @(col.Width)px; min-width: @(col.Width)px; flex-shrink: 0;">
                            @if (item.ExtraData.ContainsKey(col.DataKey)) {
                                @FormatValue(item.ExtraData[col.DataKey], col.Format)
                            } else {
                                @("-")
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public List<MyDataObj> GridDataItems { get; set; } = new();
    [Parameter] public List<GridColumn> Columns { get; set; } = new();
    [Parameter] public bool AllowSorting { get; set; } = true;

    [Parameter] public EventCallback<(MyDataObj Item, MouseEventArgs Args)> OnRowClicked { get; set; }
    [Parameter] public EventCallback<MyDataObj> OnRowDoubleClicked { get; set; }
    [Parameter] public EventCallback<(int TargetIndex, MyDataObj? DraggedItem)> OnRowDropped { get; set; }
    [Parameter] public EventCallback<(string Key, bool IsAscending)> OnSortRequested { get; set; }

    private bool _isDoubleClicking = false;  
    private string _currentSortKey = "";
    private bool _isAscending = true;
    private DateTime _lastClickTime = DateTime.MinValue;
    private MyDataObj? _lastClickedItem;
    private ElementReference _gridInputRef;

    // 「項目名」の列配置を解決するメソッド
    // もし親で "Name" という DataKey のカラム定義が存在すればその配置クラスを使い、
    // なければデフォルトで "grid-cell-left" を返す
    private string GetNameAlignClass() {
        var nameCol = Columns.FirstOrDefault(c => c.DataKey == "Name");
        return nameCol != null && !string.IsNullOrEmpty(nameCol.AlignClass) 
            ? nameCol.AlignClass 
            : "grid-cell-left";
    }

    private void Sort(string key) {
        if (!AllowSorting || GridDataItems == null || !GridDataItems.Any()) return;

        if (_currentSortKey == key) {
            _isAscending = !_isAscending;
        } else {
            _currentSortKey = key;
            _isAscending = true;
        }

        List<MyDataObj> sortedList;
        if (key == "Name") {
            sortedList = _isAscending 
                ? GridDataItems.OrderBy(i => i.Name).ToList() 
                : GridDataItems.OrderByDescending(i => i.Name).ToList();
        } else {
            Func<MyDataObj, object> keySelector = i => {
                if (!i.ExtraData.TryGetValue(key, out var val) || val == null) {
                    return string.Empty;
                }
                if (decimal.TryParse(val.ToString(), out decimal num)) {
                    return num;
                }
                return val.ToString() ?? string.Empty;
            };

            sortedList = _isAscending 
                ? GridDataItems.OrderBy(keySelector).ToList() 
                : GridDataItems.OrderByDescending(keySelector).ToList();
        }

        GridDataItems.Clear();
        GridDataItems.AddRange(sortedList);

        StateHasChanged();
    }

    private string GetSortIcon(string key) {
        if (!AllowSorting || _currentSortKey != key) return "";
        return _isAscending ? " ▲" : " ▼";
    }

    private async Task HandleClick(MyDataObj item, MouseEventArgs e) {
        var now = DateTime.Now;
        if (item == _lastClickedItem && (now - _lastClickTime).TotalMilliseconds < 300) {
            _lastClickTime = DateTime.MinValue;
            _lastClickedItem = null;

            if (OnRowDoubleClicked.HasDelegate) {
                await OnRowDoubleClicked.InvokeAsync(item);
            }
            return;
        }

        _lastClickTime = now;
        _lastClickedItem = item;

        await Task.Delay(300);
        if (_lastClickedItem != item) return;

        if (item.IsSelected) {
            await StartEditingGridItem(item);
        } else {
            if (OnRowClicked.HasDelegate) {
                await OnRowClicked.InvokeAsync((item, e));
            }
        } 
    }

    private async Task HandleDoubleClick(MyDataObj item) {
        _isDoubleClicking = true;
        if (OnRowDoubleClicked.HasDelegate) {
            await OnRowDoubleClicked.InvokeAsync(item);
        }
    }

    private async Task DropRow(int targetIndex) {
        if (OnRowDropped.HasDelegate) {
            await OnRowDropped.InvokeAsync((targetIndex, DraggingState.DraggingGridItem));
        }
    }

    private async Task StartEditingGridItem(MyDataObj item) {
        foreach (var i in GridDataItems) i.IsEditing = false;
        item.IsEditing = true;
        StateHasChanged();

        await Task.Delay(50);
        if (_gridInputRef.Context != null) {
            await _gridInputRef.FocusAsync();
        }
    }

    private string FormatValue(object val, string format) {
        if (val == null) return "-";
        if (string.IsNullOrEmpty(format)) return val.ToString();
        if (decimal.TryParse(val.ToString(), out decimal num)) {
            return num.ToString(format);
        }
        return val.ToString();
    }
}