@implements IDisposable

@using Microsoft.AspNetCore.Components
@inherits LayoutComponentBase

@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS

@using MudBlazor
@using NxRebuild.Client.Pages.Auth
@using NxRebuild.Client.Services
@using NxRebuild.Client.Pages.NxPrograms.MDI
@using NxRebuild.Client.Pages.NxPrograms.MDI.Zmst
@using NxRebuild.Client.Pages.NxPrograms.MDI.RyLib
@using NxRebuild.Client.Pages.NxPrograms.DB
@inject SessionEvents Events
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject WindowManagerBase Manager


<MudThemeProvider />
<MudPopoverProvider />

<MudLayout>

    <!-- AppBar -->
    <MudPaper Class="d-flex align-center"
              Style="
        width:100vw;
        height:64px;
        background-color:var(--mud-palette-primary);
        color:white;
        position:fixed;
        top:0;
        left:0;
        overflow: visible;
        z-index:1201;
        "
              Elevation="4">

        <MudButton Color="Color.Inherit"
                   Class="ml-4"
                   StartIcon="@Icons.Material.Filled.Menu"
                   OnClick="@ToggleDrawer">
            メニュー
        </MudButton>

        <MudSpacer />

        <div @ref="_windowActivator" style="position: relative;">
            <MudButton Color="Color.Inherit"
                       EndIcon="@Icons.Material.Filled.ArrowDropDown"
                       OnClick="@ToggleWindowMenu">
                ウィンドウ
            </MudButton>

            <MudPopover Open="_windowMenuOpen"
                        Activator="_windowActivator"
                        Fixed="true"
                        CloseOnOutsideClick="true"
                        AnchorOrigin="Origin.BottomCenter"
                        TransformOrigin="Origin.TopCenter"
                        Class="pa-0">
                <MudPaper Elevation="4" Style="min-width:120px;">
                    <MudList T="string" Dense="true">
                        @if (Manager.Windows.Count == 0)
                        {
                            <MudListItem Text="ウィンドウなし" />
                        }
                        else
                        {
                            @foreach (var w in Manager.Windows)
                            {
                                <MudListItem OnClick="@(() => Manager.Restore(w.Id))">
                                    @w.Title @(w.IsMinimized ? "(最小化)" : "")
                                </MudListItem>
                            }
                        }
                    </MudList>
                </MudPaper>
            </MudPopover>
        </div>
    </MudPaper>

    <!-- Drawer -->
    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Persistent"
               Style="margin-top: 64px;"
               Elevation="1">
        <MudNavMenu>
            <AuthorizeView>
                <Authorized>
                    <MudText Typo="Typo.h6" Class="px-4">Material</MudText>
                    <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">Icons</MudText>
                    <MudDivider Class="my-2" />

                    <MudNavLink Href="logout" Icon="@Icons.Material.Filled.Dashboard">ログアウト</MudNavLink>
                    <MudNavLink OnClick="@(() => Manager.Open<FrmNutProperties>("栄養素設定"))" Icon="@Icons.Material.Filled.List">栄養素設定</MudNavLink>
                    <MudNavLink Icon="@Icons.Material.Filled.List" OnClick="@OpenZmst">材料マスタ</MudNavLink>
                    <MudNavLink Icon="@Icons.Material.Filled.List" OnClick="@OpenRyLib">料理ライブラリ</MudNavLink>
                </Authorized>

                <NotAuthorized>
                    <MudNavLink Href="login" Icon="@Icons.Material.Filled.Dashboard">ログイン</MudNavLink>
                </NotAuthorized>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>

    <!-- Main Content -->
    <MudMainContent Style="padding-top: 64px;">
            @Body
    </MudMainContent>

</MudLayout>

@code {

    private ElementReference _windowActivator;
    private bool _windowMenuOpen = false;
    private bool _drawerOpen = true;

    protected override void OnInitialized()
    {
        Manager.OnWindowsChanged += OnWindowsChangedHandler;
        Events.Unauthorized += OnUnauthorized;
    }

    private void OnWindowsChangedHandler()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnUnauthorized() => _ = InvokeAsync(async () =>
    {
        GlobalState.Reset(); // 定期同期を止める
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "authToken");
        ((CustomAuthStateProvider)AuthProvider).NotifyUserLogout();
        Nav.NavigateTo("/login", forceLoad: true);
    });

    public void Dispose()
    {
        // 登録したイベントは必ず解除する
        Manager.OnWindowsChanged -= OnWindowsChangedHandler;
        Events.Unauthorized -= OnUnauthorized;
    }

    private void OpenZmst()
    {
        Manager.Open<FrmZmstView>("材料マスタ");
    }

    // ★ 料理ライブラリ画面を MDI ウィンドウで開くハンドラー
    private void OpenRyLib()
    {
        Manager.Open<FrmRyLibView>("料理ライブラリ");
    }

    private void ToggleWindowMenu() => _windowMenuOpen = !_windowMenuOpen;
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}