<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
   
    <!-- <InvariantGlobalization>false</InvariantGlobalization> -->
       <!-- AOT 完全停止  -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>
<!-- <PropertyGroup>
  <TargetFramework>net10.0</TargetFramework>
  <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
  
  <WasmBuildNative>false</WasmBuildNative>

  <PublishTrimmed>false</PublishTrimmed>
  
  <ReportAnalyzerDiagnostics>false</ReportAnalyzerDiagnostics>
</PropertyGroup> -->

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="MudBlazor" Version="9.8.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.53.4" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NxRebuild.shared\NxRebuild.shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\sample-data\" />
  </ItemGroup>

</Project>
