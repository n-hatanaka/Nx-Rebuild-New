
@inherits FrmZmstViewBase
@using MudBlazor
@using NxRebuild.Client.Services
@using NxRebuild.shared
@using NxRebuild.Client.Pages.NxPrograms.MDI.Tree_List_View

<style>
    /* 画面全体のレイアウト（左右並び・隙間・高さ） */
    .app-container {
        display: flex;
        flex-direction: row;
        gap: 10px;
        flex: 1; /* ← ウインドウに合わせて伸縮 */
        min-height: 0; /* ← はみ出し防止 */
        min-width: 0;
        width: 100%; /* ← これで flex の誤判定を完全に防ぐ */
        overflow: hidden;
        color: black;
        padding: 5px; /* ← 上下左右すべてに余白 */
        box-sizing: border-box;
    }

    /* 画面が狭い時のレスポンシブ制御（上下並び替え、器の大きさ調整） */
    @@media (max-width: 700px) {
        .app-container {
            flex-direction: column;
        }

        .tree-pane {
            flex: 0 0 25% !important;
            width: 100% !important;
            max-height: 25% !important;
        }

        .grid-pane {
            flex: 1 !important;
            width: 100% !important;
        }
    }

    /* スクロール領域の基本枠（中身の配置とスクロール可否） */
    .scroll-pane {
        background-color: white;
        border: 1px solid #ccc;
        padding: 10px;
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow-y: auto;
        overflow-x: auto;
    }

    .tree-pane {
        flex: 0 0 300px;
        min-width: 250px;
        min-height: 0; /* ← 必須 */
    }

    .grid-pane {
        flex: 2;
        min-width: 0;
        min-height: 0; /* ← 必須 */
    }
</style>

<div class="app-container">
    @* A. ツリーコンポーネント (イベント処理を外部結合) *@
    <AknTreeView TKey="int"
                 TreeData="TreeData"
                 OnNodeSelected="HandleNodeSelection"
                 OnNodeDropped="HandleNodeDrop"
                 @ref="_treeview" />

    @* B. グリッドコンポーネント (イベント処理を外部結合) *@
    @* ソート機能を無効化する場合（AllowSorting="false" を渡す） *@
    <AknListView TKey="int"
                 ListDataItems="GridDataItems"
                 Columns="Columns"
                 AllowSorting="true"
                 OnRowClicked="HandleGridClick"
                 OnRowDoubleClicked="HandleGridDoubleClick"
                 OnRowDropped="HandleGridReorder"
                 OnSortRequested="HandleSortRequest"
                 @ref="_listview" />
</div>

@code {
    private bool _initialized = false;

    protected override async Task OnInitializedAsync()
    {
        ZmstMgr = GlobalState.ZmstEntityMgr;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;

        _initialized = true;

        SetManager(ZmstMgr);

        AddDefaultColumns();
    }

}
