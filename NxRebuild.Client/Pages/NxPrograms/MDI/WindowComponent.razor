@using Microsoft.AspNetCore.Components
@inject IJSRuntime JS
@implements IDisposable

@if (!Info.IsMinimized)
{
    <div @ref="windowRef"
         class="mdi-window @(Info.IsMaximized ? "mdi-maximized" : "")"
         style="left:@(Info.X)px; top:@(Info.Y)px; width:@(Info.Width)px; height:@(Info.Height)px; z-index:@Info.Z;"
         @onclick="() => Manager.BringToFront(Info)">

        <div class="mdi-titlebar">
            <span class="mdi-title-text">@Info.Title</span>
            <div class="mdi-buttons">
                <button class="mdi-btn" @onclick="Minimize" title="最小化">＿</button>
                <button class="mdi-btn" @onclick="ToggleMaximize" title="最大化">□</button>
                <button class="mdi-btn" @onclick="() => Manager.Close(Info.Id)" title="閉じる">✕</button>
            </div>
        </div>

        <div class="mdi-content">
            <DynamicComponent Type="Info.ComponentType" Parameters="Info.Parameters" />
        </div>

        <div class="resize-handle resize-nw"></div>
        <div class="resize-handle resize-ne"></div>
        <div class="resize-handle resize-sw"></div>
        <div class="resize-handle resize-se"></div>

        <div class="resize-handle resize-n"></div>
        <div class="resize-handle resize-s"></div>
        <div class="resize-handle resize-w"></div>
        <div class="resize-handle resize-e"></div>
    </div>
}

@code {
    [Parameter] public WindowInfo Info { get; set; } = default!;
    [Parameter] public WindowManagerBase Manager { get; set; } = default!;

    private ElementReference windowRef;
    private const double NavbarHeight = 48;

    private DotNetObjectReference<WindowComponent>? _dotNetRef;
    private bool _jsReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Info.IsMinimized)
        {
            _jsReady = false;
            return;
        }

        if (_jsReady) return;
        _jsReady = true;

        _dotNetRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("mdi.initDrag", windowRef, _dotNetRef);
        await JS.InvokeVoidAsync("mdi.initResizeMulti", windowRef, _dotNetRef);
    }

    [JSInvokable]
    public void UpdatePosition(double x, double y)
    {
        Info.X = x;
        Info.Y = y;
    }

    [JSInvokable]
    public void UpdateSize(double w, double h)
    {
        Info.Width = w;
        Info.Height = h;
    }

    [JSInvokable]
    public void UpdateBounds(double x, double y, double w, double h)
    {
        Info.X = x;
        Info.Y = y;
        Info.Width = w;
        Info.Height = h;
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }

    private void ToggleMaximize()
    {
        if (!Info.IsMaximized)
        {
            Info.PrevX = Info.X;
            Info.PrevY = Info.Y;
            Info.PrevWidth = Info.Width;
            Info.PrevHeight = Info.Height;

            Info.X = 0;
            Info.Y = NavbarHeight;
            Info.Width = Manager.ScreenWidth;
            Info.Height = Manager.ScreenHeight - NavbarHeight;

            Info.IsMaximized = true;
        }
        else
        {
            Info.X = Info.PrevX;
            Info.Y = Info.PrevY;
            Info.Width = Info.PrevWidth;
            Info.Height = Info.PrevHeight;

            Info.IsMaximized = false;
        }

        Manager.NotifyWindowsChanged();
    }

    private void Minimize()
    {
        Info.IsMinimized = true;
        Manager.NotifyWindowsChanged();
    }
}