@using Microsoft.AspNetCore.Components
@inject IJSRuntime JS

<style>
    .mdi-window {
        position: fixed;
        background: white;
        border: 1px solid #ccc;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        z-index: 9999;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .mdi-titlebar {
        height: 32px;
        background: #eee;
        display: flex;
        align-items: center;
        padding: 0 8px;
        cursor: move;
        flex-shrink: 0;
    }

    .mdi-content {
        flex: 1;
        min-height: 0;
        min-width: 0;
        overflow: auto;
        display: flex;
    }

    .mdi-buttons {
        margin-left: auto;
        display: flex;
        gap: 4px;
    }

    .mdi-btn {
        width: 24px;
        height: 24px;
        border: none;
        background: transparent;
        cursor: pointer;
        font-size: 14px;
    }

    .resize-handle {
        position: absolute;
        background: transparent;
    }

    .resize-nw { top: 0; left: 0; width: 12px; height: 12px; cursor: nw-resize; }
    .resize-ne { top: 0; right: 0; width: 12px; height: 12px; cursor: ne-resize; }
    .resize-sw { bottom: 0; left: 0; width: 12px; height: 12px; cursor: sw-resize; }
    .resize-se { bottom: 0; right: 0; width: 12px; height: 12px; cursor: se-resize; }

    .resize-n { top: 0; left: 12px; right: 12px; height: 6px; cursor: n-resize; }
    .resize-s { bottom: 0; left: 12px; right: 12px; height: 6px; cursor: s-resize; }
    .resize-w { left: 0; top: 12px; bottom: 12px; width: 6px; cursor: w-resize; }
    .resize-e { right: 0; top: 12px; bottom: 12px; width: 6px; cursor: e-resize; }
</style>

@if (!Info.IsMinimized)
{
    <div @ref="windowRef"
         class="mdi-window @(Info.IsMaximized ? "mdi-maximized" : "")"
         style="
        left:@Info.Xpx;
        top:@Info.Ypx;
        width:@Info.Wpx;
        height:@Info.Hpx;
        z-index:@Info.Z;"
         @onclick="() => Manager.BringToFront(Info)">

        <div class="mdi-titlebar">
            <span>@Info.Title</span>
            <div class="mdi-buttons">
                <button class="mdi-btn" @onclick="Minimize">＿</button>
                <button class="mdi-btn" @onclick="ToggleMaximize">□</button>
                <button class="mdi-btn" @onclick="() => Manager.Close(Info.Id)">✕</button>
            </div>
        </div>

        <div class="mdi-content">
            <DynamicComponent Type="Info.ComponentType" Parameters="Info.Parameters" />
        </div>

        <div class="resize-handle resize-nw"></div>
        <div class="resize-handle resize-ne"></div>
        <div class="resize-handle resize-sw"></div>
        <div class="resize-handle resize-se"></div>

        <div class="resize-handle resize-n"></div>
        <div class="resize-handle resize-s"></div>
        <div class="resize-handle resize-w"></div>
        <div class="resize-handle resize-e"></div>
    </div>
}

@code {
    [Parameter] public WindowInfo Info { get; set; } = default!;
    [Parameter] public WindowManagerBase Manager { get; set; } = default!;

    private ElementReference windowRef;
    private const double NavbarHeight = 48;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Info.IsMinimized)
        {
            var dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("mdi.initDrag", windowRef, dotNetRef);
            await JS.InvokeVoidAsync("mdi.initResizeMulti", windowRef, dotNetRef);
        }
    }

    [JSInvokable]
    public void UpdatePosition(double x, double y)
    {
        Info.X = x;
        Info.Y = y;
        Manager.OnWindowsChanged?.Invoke();
    }

    [JSInvokable]
    public void UpdateSize(double w, double h)
    {
        Info.Width = w;
        Info.Height = h;
        Manager.OnWindowsChanged?.Invoke();
    }

    private void ToggleMaximize()
    {
        if (!Info.IsMaximized)
        {
            Info.PrevX = Info.X;
            Info.PrevY = Info.Y;
            Info.PrevWidth = Info.Width;
            Info.PrevHeight = Info.Height;

            Info.X = 0;
            Info.Y = NavbarHeight;
            Info.Width = Manager.ScreenWidth;
            Info.Height = Manager.ScreenHeight - NavbarHeight;

            Info.IsMaximized = true;
        }
        else
        {
            Info.X = Info.PrevX;
            Info.Y = Info.PrevY;
            Info.Width = Info.PrevWidth;
            Info.Height = Info.PrevHeight;

            Info.IsMaximized = false;
        }

        Manager.OnWindowsChanged?.Invoke();
    }

    private void Minimize()
    {
        Info.IsMinimized = true;
        Manager.OnWindowsChanged?.Invoke();
    }
}