@using Microsoft.AspNetCore.Components
@inject IJSRuntime JS
@implements IDisposable

<style>
    .mdi-window {
        position: fixed;
        background: white;
        border: 1px solid #ccc;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        z-index: 9999;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-sizing: border-box; /* ★ 枠線分で毎回2pxずつ大きくならないように */
        will-change: transform;
    }

    .mdi-titlebar {
        height: 32px;
        background: #eee;
        display: flex;
        align-items: center;
        padding: 0 8px;
        cursor: move;
        flex-shrink: 0;
    }

    .mdi-content {
        flex: 1;
        min-height: 0;
        min-width: 0;
        overflow: auto;
        display: flex;
    }

    .mdi-buttons {
        margin-left: auto;
        display: flex;
        gap: 4px;
    }

    .mdi-btn {
        width: 24px;
        height: 24px;
        border: none;
        background: transparent;
        cursor: pointer;
        font-size: 14px;
    }

    .resize-handle {
        position: absolute;
        background: transparent;
        z-index: 10;
        touch-action: none;
    }

    .resize-nw, .resize-ne, .resize-sw, .resize-se {
        z-index: 11; /* 角は辺より前面 */
    }

    .resize-nw {
        top: 0;
        left: 0;
        width: 12px;
        height: 12px;
        cursor: nw-resize;
    }

    .resize-ne {
        top: 0;
        right: 0;
        width: 12px;
        height: 12px;
        cursor: ne-resize;
    }

    .resize-sw {
        bottom: 0;
        left: 0;
        width: 12px;
        height: 12px;
        cursor: sw-resize;
    }

    .resize-se {
        bottom: 0;
        right: 0;
        width: 12px;
        height: 12px;
        cursor: se-resize;
    }

    .resize-n {
        top: 0;
        left: 12px;
        right: 12px;
        height: 6px;
        cursor: n-resize;
    }

    .resize-s {
        bottom: 0;
        left: 12px;
        right: 12px;
        height: 6px;
        cursor: s-resize;
    }

    .resize-w {
        left: 0;
        top: 12px;
        bottom: 12px;
        width: 6px;
        cursor: w-resize;
    }

    .resize-e {
        right: 0;
        top: 12px;
        bottom: 12px;
        width: 6px;
        cursor: e-resize;
    }
</style>

@if (!Info.IsMinimized)
{
    <div @ref="windowRef"
         class="mdi-window @(Info.IsMaximized ? "mdi-maximized" : "")"
         style="
        left:@Info.Xpx;
        top:@Info.Ypx;
        width:@Info.Wpx;
        height:@Info.Hpx;
        z-index:@Info.Z;"
         @onclick="() => Manager.BringToFront(Info)">

        <div class="mdi-titlebar">
            <span>@Info.Title</span>
            <div class="mdi-buttons">
                <button class="mdi-btn" @onclick="Minimize">＿</button>
                <button class="mdi-btn" @onclick="ToggleMaximize">□</button>
                <button class="mdi-btn" @onclick="() => Manager.Close(Info.Id)">✕</button>
            </div>
        </div>

        <div class="mdi-content">
            <DynamicComponent Type="Info.ComponentType" Parameters="Info.Parameters" />
        </div>

        <div class="resize-handle resize-nw"></div>
        <div class="resize-handle resize-ne"></div>
        <div class="resize-handle resize-sw"></div>
        <div class="resize-handle resize-se"></div>

        <div class="resize-handle resize-n"></div>
        <div class="resize-handle resize-s"></div>
        <div class="resize-handle resize-w"></div>
        <div class="resize-handle resize-e"></div>
    </div>
}

@code {
    [Parameter] public WindowInfo Info { get; set; } = default!;
    [Parameter] public WindowManagerBase Manager { get; set; } = default!;

    private ElementReference windowRef;
    private const double NavbarHeight = 48;

    private DotNetObjectReference<WindowComponent>? _dotNetRef;
    private bool _jsReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Info.IsMinimized)
        {
            // 最小化中は DOM 要素が無い → 復元されたら再初期化する
            _jsReady = false;
            return;
        }

        // ★ 初期化は要素ごとに1回だけ(再レンダリングのたびに呼ばない)
        if (_jsReady) return;
        _jsReady = true;

        _dotNetRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("mdi.initDrag", windowRef, _dotNetRef);
        await JS.InvokeVoidAsync("mdi.initResizeMulti", windowRef, _dotNetRef);
    }

    // ★ JS 側ですでに DOM を更新済みなので、ここでは再描画しない
    //   (再描画すると中の DynamicComponent = ツリー/グリッドまで再描画されて重い)
    [JSInvokable]
    public void UpdatePosition(double x, double y)
    {
        Info.X = x;
        Info.Y = y;
    }

    [JSInvokable]
    public void UpdateSize(double w, double h)
    {
        Info.Width = w;
        Info.Height = h;
    }

    [JSInvokable]
    public void UpdateBounds(double x, double y, double w, double h)
    {
        Info.X = x;
        Info.Y = y;
        Info.Width = w;
        Info.Height = h;
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }

    private void ToggleMaximize()
    {
        if (!Info.IsMaximized)
        {
            Info.PrevX = Info.X;
            Info.PrevY = Info.Y;
            Info.PrevWidth = Info.Width;
            Info.PrevHeight = Info.Height;

            Info.X = 0;
            Info.Y = NavbarHeight;
            Info.Width = Manager.ScreenWidth;
            Info.Height = Manager.ScreenHeight - NavbarHeight;

            Info.IsMaximized = true;
        }
        else
        {
            Info.X = Info.PrevX;
            Info.Y = Info.PrevY;
            Info.Width = Info.PrevWidth;
            Info.Height = Info.PrevHeight;

            Info.IsMaximized = false;
        }

        Manager.NotifyWindowsChanged();
    }

    private void Minimize()
    {
        Info.IsMinimized = true;
        Manager.NotifyWindowsChanged();
    }
}
