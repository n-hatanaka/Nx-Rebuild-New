@page "/Home"

@inject IJSRuntime JS
@using System.Net.Http.Headers
@using MudBlazor
@using NxRebuild.Client.Pages.NxPrograms.MDI
@using NxRebuild.Client.Pages.NxPrograms.MDI.Tree_List_View
@inject WindowManagerBase Manager

@using System.Diagnostics
@using NxRebuild.Client.Services
@using NxRebuild.Client.Pages.NxPrograms.DB

@using Microsoft.AspNetCore.Components.Authorization
@using Dapper
@inject AuthenticationStateProvider AuthProvider
@inject IHttpClientFactory ClientFactory


@using NxRebuild.Client.Pages.Auth
@inject InMemoryDatabaseState DbState

<h3>MainWnd</h3>
<hr />

@if (isInitializing)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    <p>@initMessage</p>
    @* 初期化中はここで描画を止める *@
    return;
}

@if (DbState.IsInitialized)
{
    <p style="color:green">インメモリDB準備完了！</p>
}
else
{
    <p>データベース初期化中</p>
}

<div>Hash: @Manager.GetHashCode()</div>

<WindowManager Manager="Manager" />

<MudButton OnClick="@(() => Manager.Open<AknTreeListView>("プロジェクト編集"))">
    プロジェクト編集を開く
</MudButton>

<MudCard Class="mt-4 pa-4" Style="background-color: #fafafa; border: 1px dashed #ccc;">
    <MudText Typo="Typo.h6" Color="Color.Primary">👁 目隠し解除：簡易SQLコンソール</MudText>
    <MudText Typo="Typo.caption">※インメモリDBに対して任意のSQL（SELECTなど）を実行できます。</MudText>

    <MudTextField @bind-Value="sqlQuery" Label="SQLクエリを入力" Variant="Variant.Outlined" Lines="3" Class="mt-2" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExecuteQuery" Class="mt-2">SQL実行</MudButton>

    @if (!string.IsNullOrEmpty(queryError))
    {
        <MudText Color="Color.Error" Class="mt-2">⚠️ @queryError</MudText>
    }

    @if (queryResult != null && queryResult.Any())
    {
        <div style="overflow-x: auto; max-height: 300px; margin-top: 15px;">
            <table style="width: 100%; border-collapse: collapse; background-color: white; font-size: 13px;">
                <thead>
                    <tr style="background-color: #e0e0e0;">
                        @foreach (var header in headers)
                        {
                            <th style="border: 1px solid #ccc; padding: 6px; text-align: left;">@header</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in queryResult)
                    {
                        <tr>
                            @foreach (var header in headers)
                            {
                                <td style="border: 1px solid #ccc; padding: 6px;">
                                    @row[header]?.ToString()
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</MudCard>

@code {

    HttpClient Http;

    private bool isInitializing = true;
    private string initMessage = "初期化開始...";
    protected override void OnInitialized()
    {
        Http = ClientFactory.CreateClient("SecureClient");
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeAsync();
            StateHasChanged();
        }
    }

    private async Task InitializeAsync()
    {
        initMessage = "認証状態確認中...";
        StateHasChanged();

        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;
        var tenantCode = user.FindFirst("tenant_code")?.Value;

        if (user.Identity is { IsAuthenticated: true } && !DbState.IsInitialized)
        {
            try
            {
                initMessage = "スキーマ取得中...";
                StateHasChanged();

                string jsonResult = await Http.GetStringAsync("api/GetScm");

                initMessage = "インメモリDB構築中...";
                StateHasChanged();

                DbState.Initialize(jsonResult);

                initMessage = "マスタ同期中...";
                StateHasChanged();

                var masterTables = new List<string> { "Zmst", "tan_m", "ColName", "gun_m" };
                await DbState.SyncMasterDataAsync(Http, masterTables, tenantCode);

                initMessage = "栄養素プロパティ初期化中...";
                StateHasChanged();

                var customAuth = AuthProvider as CustomAuthStateProvider;
                var tenantGuid = Guid.TryParse(tenantCode, out var tg) ? tg : Guid.Empty;

                var userIdClaim = user.FindFirst(System.IdentityModel.Tokens.Jwt.JwtRegisteredClaimNames.Sub)
                                 ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);

                Guid currentUserGuid = Guid.TryParse(userIdClaim?.Value, out var ug) ? ug : Guid.Empty;

                GlobalState.NutProperties =
                    new SyncNutPropertyObjMgr(DbState.Connection, Http, customAuth, tenantGuid, currentUserGuid);

                GlobalState.NutProperties.Initialize();
            }
            catch (Exception ex)
            {
                initMessage = $"初期化エラー: {ex.Message}";
                StateHasChanged();
            }
        }

        initMessage = "初期化完了！";
        isInitializing = false;
        StateHasChanged();
    }

    private string sqlQuery = "SELECT name, tbl_name FROM sqlite_master WHERE type='table';";
    private string queryError = string.Empty;
    private List<IDictionary<string, object>>? queryResult;
    private List<string> headers = new();

    private async Task ExecuteQuery()
    {
        if (DbState.Connection == null)
        {
            queryError = "データベースが初期化されていません。";
            return;
        }

        queryError = string.Empty;
        queryResult = null;
        headers.Clear();

        var sw = Stopwatch.StartNew();
        try
        {
            var rawResult = DbState.Connection.Query(sqlQuery);
            queryResult = rawResult.Select(x => (IDictionary<string, object>)x).ToList();

            if (queryResult.Any())
                headers = queryResult.First().Keys.ToList();
            else
                queryError = "クエリは成功しましたが、結果は0件でした。";
        }
        catch (Exception ex)
        {
            queryError = $"SQLエラー: {ex.Message}";
        }

        sw.Stop();
        Console.WriteLine($"★ [DEBUG] C#のデータ取得と変換にかかった時間: {sw.ElapsedMilliseconds} ms");
    }
}
