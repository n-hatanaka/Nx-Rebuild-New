@page "/"

@using Microsoft.AspNetCore.Components.Authorization;
@inject AuthenticationStateProvider AuthProvider
@inject HttpClient Http

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.
<AuthorizeView>
    <Authorized>
        <p style="color:green">ログイン状態です</p>

        <hr />
        <h3>PostgreSQL -> SQLite スキーマ変換結果 (JSON)</h3>

        @if (string.IsNullOrEmpty(jsonResult))
        {
            <p><em>データを取得中、またはサーバーが起動していません...</em></p>
        }
        else
        {
            <pre style="background-color: #f5f5f5; padding: 15px; border-radius: 5px; border: 1px solid #ccc; max-height: 400px; overflow-y: auto;">
                <code>@jsonResult</code>
            </pre>
        }

    </Authorized>
    <NotAuthorized>
        <p style="color:red">未ログインです</p>
    </NotAuthorized>
</AuthorizeView>

<button @onclick="ShowClaims">Claims を確認</button>

@code {

    private string jsonResult = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // 1. 現在のログイン状態を取得します
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;

        // 2. ログインしている場合（IsAuthenticated が true）のみAPIを呼び出します
        if (user.Identity is { IsAuthenticated: true })
        {
            await FetchSchemaJsonAsync();
        }
    }

    private async Task FetchSchemaJsonAsync()
    {
        try
        {
            jsonResult = await Http.GetStringAsync("api/GetScm");
        }
        catch (Exception ex)
        {
            jsonResult = $"エラーが発生しました: {ex.Message}";
        }
    }

    private async Task ShowClaims()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;

        Console.WriteLine("IsAuthenticated: " + user.Identity?.IsAuthenticated);

        foreach (var c in user.Claims)
        {
            Console.WriteLine($"{c.Type} = {c.Value}");
        }
    }
}