@page "/login"
@using Microsoft.AspNetCore.Components.Authorization;
@using System.Security.Claims;
@using NxRebuild.Client.Pages.Auth
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject HttpClient Http
@inject IJSRuntime JS

<h3>ログイン</h3>

<div class="login-container">

    <div class="preset-users">
        <button @onclick="() => SetPresetUser(1)">ユーザー①</button>
        <button @onclick="() => SetPresetUser(2)">ユーザー②</button>
    </div>

    <div class="input-group">
        <label>Email</label>
        <input @bind="Email" />
    </div>

    <div class="input-group">
        <label>Password</label>
        <input type="password" @bind="Password" />
    </div>

    <button class="login-button" @onclick="DoLogin">ログイン</button>
</div>

@code {
    string Email = "";
    string Password = "";
    private string? ErrorMessage;
    
    void SetPresetUser(int n)
    {
        if (n == 1)
        {
            Email = "test@example.com";
            Password = "Test123!";
        }
        else if (n == 2)
        {
            Email = "test2@example2.com";
            Password = "Test223!";
        }
    }

    private async Task DoLogin()
    {
        var result = await Http.PostAsJsonAsync("auth/login", new { Email, Password });

        if (!result.IsSuccessStatusCode)
        {
            ErrorMessage = "ログイン失敗";
            return;
        }

        var json = await result.Content.ReadFromJsonAsync<LoginResponse>();

        // JWT を sessionStorage に保存
        await JS.InvokeVoidAsync("sessionStorage.setItem", "authToken", json!.token);

        // TenantCode 保存
        await JS.InvokeVoidAsync("sessionStorage.setItem", "tenant_code", json!.TenantCode);

        // JWT を AuthStateProvider に通知
        var provider = (CustomAuthStateProvider)AuthProvider;
        provider.NotifyUserAuthentication(json.token);

        // ホームへ
        Nav.NavigateTo("/Home");
    }

    public class LoginResponse
    {
        public string token { get; set; }
        public string TenantCode { get; set; }
    }

}
