@page "/logout"
@using Microsoft.AspNetCore.Components.Authorization;
@using System.Security.Claims;
@using NxRebuild.Client.Pages.Auth

@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<h3>ログアウト中...</h3>


@code {
@using NxRebuild.Client.Services

    protected override async Task OnInitializedAsync()
    {
        GlobalState.Reset();
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "authToken");
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "tenant_code");
        ((CustomAuthStateProvider)AuthProvider).NotifyUserLogout();
        Nav.NavigateTo("/login", forceLoad: true);   // リロードでインメモリDBも破棄される
    }
}
